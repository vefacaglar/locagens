{
  // Locagens run configurations (no debugger).
  //
  // `node-terminal` just runs the command in an integrated terminal, so no
  // C++/LLDB extensions are needed. On Windows the GNU toolchain is used
  // (no MSVC build tools required) with w64devkit's gcc/dlltool on PATH.
  "version": "0.2.0",
  "configurations": [
    {
      "name": "Run Locagens Desktop",
      "type": "node-terminal",
      "request": "launch",
      "command": "cargo run -p locagens-desktop --bin locagens",
      "cwd": "${workspaceFolder}",
      "windows": {
        "command": "rustup run stable-x86_64-pc-windows-gnu cargo run -p locagens-desktop --bin locagens",
        "env": { "PATH": "${env:USERPROFILE}\\w64devkit\\w64devkit\\bin;${env:PATH}" }
      }
    },
    {
      "name": "Run Locagens Desktop (Release)",
      "type": "node-terminal",
      "request": "launch",
      "command": "cargo run --release -p locagens-desktop --bin locagens",
      "cwd": "${workspaceFolder}",
      "windows": {
        "command": "rustup run stable-x86_64-pc-windows-gnu cargo run --release -p locagens-desktop --bin locagens",
        "env": { "PATH": "${env:USERPROFILE}\\w64devkit\\w64devkit\\bin;${env:PATH}" }
      }
    },
    {
      "name": "Run lcgn CLI",
      "type": "node-terminal",
      "request": "launch",
      "command": "cargo run -p locagens-cli --bin lcgn",
      "cwd": "${workspaceFolder}",
      "windows": {
        "command": "rustup run stable-x86_64-pc-windows-gnu cargo run -p locagens-cli --bin lcgn",
        "env": { "PATH": "${env:USERPROFILE}\\w64devkit\\w64devkit\\bin;${env:PATH}" }
      }
    }
  ]
}
