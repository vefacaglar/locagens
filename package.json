{
  "name": "locagens",
  "private": true,
  "engines": {
    "node": ">=18.0.0",
    "pnpm": ">=8.0.0"
  },
  "scripts": {
    "dev:shared": "pnpm --filter @locagens/shared dev",
    "dev:api": "cargo run --manifest-path apps/backend/Cargo.toml",
    "dev:web": "pnpm --filter @locagens/web dev",
    "dev": "pnpm --recursive --parallel dev",
    "dev:desktop": "pnpm --filter @locagens/desktop start",
    "build:backend": "cargo build --release --manifest-path apps/backend/Cargo.toml",
    "build": "pnpm --recursive build",
    "dist": "pnpm run build:backend && pnpm --filter @locagens/shared build && pnpm --filter @locagens/web build && pnpm --filter @locagens/desktop run dist",
    "clean": "pnpm --recursive exec rm -rf dist node_modules"
  },
  "devDependencies": {
    "typescript": "^5.4.5"
  }
}
